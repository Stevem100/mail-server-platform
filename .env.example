# --- Mail Server Platform settings (mirror of the design doc ".env (the settings that matter)") ---

# App
APP_SECRET=change-me-app-secret          # derives the Fernet key that encrypts DKIM private keys
API_HOST=0.0.0.0
API_PORT=8080

# Mail identity
MAIL_HOSTNAME=mail.yourplatform.com      # A record + PTR must point here (one-time server setup)
SERVER_IP=203.0.113.10                   # placeholder public IP used in the generated SPF record
DKIM_SELECTOR=s1

# Metadata database (PostgreSQL 16)
DATABASE_URL=postgresql+psycopg2://mail:change-me@localhost:5432/mail

# Queue + rate limits (Redis 7)
REDIS_URL=redis://localhost:6379/0

# Object storage (MinIO or any S3 API; swap by changing these four, per the design doc)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=mail-data
S3_KEY=change-me
S3_SECRET=change-me-too
S3_REGION=us-east-1
PRESIGN_EXPIRES_S=300                    # pre-signed GET URLs are valid for 5 minutes

# SMTP listeners
INBOUND_PORT=25                          # port 25: inbound from the world
SUBMISSION_PORT=587                      # port 587: authenticated submission (STARTTLS in prod)
LMTP_PORT=2424                           # inbound worker LMTP listener
# SMTP_RELAY_HOST=127.0.0.1              # optional smarthost; empty = direct MX delivery on port 25
# SMTP_RELAY_PORT=25

# Workers
WEBHOOK_MAX_ATTEMPTS=5                   # 5 attempts with backoff, then marked failed
VERIFY_INTERVAL_S=3600                   # hourly active-domain re-check job
RETENTION_SWEEP_INTERVAL_S=3600
RETENTION_DEFAULT_DAYS=90                # bucket lifecycle default from the design doc

# Optional managed DNS (PowerDNS HTTP API); unset = show records to the user instead
# PDNS_API_URL=http://pdns:8081
# PDNS_API_KEY=change-me-three
